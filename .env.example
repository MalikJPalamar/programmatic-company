# ============================================
# UAPP Environment Variables
# Copy to .env and fill in your real values
# ============================================

# --- Router ---
UAPP_API_KEY=your-secret-api-key-here
PORT=3100

# --- Domain (for Traefik) ---
DOMAIN=yourdomain.com

# --- BuilderBee (GHL) ---
GHL_API_KEY=your-ghl-api-key
GHL_LOCATION_ID=your-default-location-id

# --- AOB: Ontraport ---
ONTRAPORT_API_KEY=your-ontraport-api-key
ONTRAPORT_APP_ID=your-ontraport-app-id

# --- AOB: Stripe ---
STRIPE_SECRET_KEY=sk_live_your-stripe-key

# --- AOB: Mighty Networks ---
MIGHTY_API_KEY=your-mighty-api-key
MIGHTY_COMMUNITY_ID=your-community-id

# --- AOB: RetreatGuru ---
RETREATGURU_API_KEY=your-retreatguru-api-key

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_ALLOWED_CHAT_IDS=your-chat-id-here
